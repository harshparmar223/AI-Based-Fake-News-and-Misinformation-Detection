# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-a-random-secret
APP_DEBUG=True

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/fake_news.db
# DATABASE_URL=postgresql://user:password@localhost:5432/fake_news_db

# ── External Fact-Check APIs ─────────────────────────────────────────────────
GOOGLE_FACT_CHECK_API_KEY=your_google_api_key_here
NEWS_API_KEY=your_newsapi_key_here

# ── Hugging Face ─────────────────────────────────────────────────────────────
HF_TOKEN=your_huggingface_token_here
HF_MODEL_NAME=roberta-base

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/app.log

